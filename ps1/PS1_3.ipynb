   "source": [
    "#problem 3\n",
    "import numpy as np\n",
    "def Pascal_triangle(k):\n",
    "    A=np.ones(1)\n",
    "    for i in range(1,k):\n",
    "        B=np.ones(i+1)\n",
    "        for j in range(1,i):\n",
    "            B[j]=A[j-1]+A[j]\n",
    "        A=B\n",
    "    print(A)\n",
    "x=100\n",
    "y=200\n",
    "Pascal_triangle(x)\n",
    "Pascal_triangle(y)\n"
   ]
